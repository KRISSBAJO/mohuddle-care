# Milestone environment. Copy to .env and fill in. Never commit .env.
APP_URL=http://localhost:3400
# on: each agency at its own address (milestone.localhost:3400), and app.localhost:3400 to sign in
AGENCY_ADDRESSES=off

# PostgreSQL. `pnpm db:up` starts a local one that matches these values.
POSTGRES_USER=milestone
POSTGRES_PASSWORD=change-me
POSTGRES_DB=milestone
POSTGRES_PORT=15450
DATABASE_URL=postgres://milestone:change-me@127.0.0.1:15450/milestone

# Secret used to sign session cookies. At least 32 characters.
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Demo sign-in created by `pnpm db:seed` (development only).
SEED_ADMIN_EMAIL=admin@milestonecare.net
SEED_ADMIN_PASSWORD=Milestone-demo-2026

# Document storage. Leave S3_BUCKET empty in development: files are kept in STORAGE_DIR on this machine.
# In production set the bucket and keys. The bucket should block public access; the Hub serves files itself.
# S3_ENDPOINT is only for S3-compatible stores such as Cloudflare R2 or MinIO.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PREFIX=milestone/
STORAGE_DIR=.storage
MAX_UPLOAD_MB=20

# Note scribe: staff speak a note and a local model drafts it. Everything runs on this machine; audio is
# never stored or sent anywhere. SCRIBE_PYTHON must have faster-whisper installed. The Whisper models live
# in SCRIBE_WHISPER_ROOT as faster-whisper-small, -medium and -turbo. OLLAMA_URL is a running Ollama.
SCRIBE_PYTHON=E:/Mohuddle/runtime/speech/Scripts/python.exe
SCRIBE_WHISPER_ROOT=E:/Mohuddle/models/whisper
OLLAMA_URL=http://127.0.0.1:11434

# Phone and browser notifications (web push). Generate once per server:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_SUBJECT is a contact address for the push services, as a mailto: link.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.test

# Secret for the reminder tick at /api/cron/sweep. The server calls it every minute by itself;
# a hosted deployment can call it from a scheduled job instead, with "Authorization: Bearer <secret>".
CRON_SECRET=
