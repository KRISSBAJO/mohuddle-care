{
  "expo": {
    "name": "Mohuddle",
    "slug": "mohuddle",
    "scheme": "mohuddle",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mohuddle.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Mohuddle uses Face ID to unlock, so people's care records stay private if your phone is left open."
      }
    },
    "android": {
      "package": "com.mohuddle.app",
      "adaptiveIcon": {
        "backgroundColor": "#173e35",
        "foregroundImage": "./assets/mohuddle-icon-v2.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mohuddle uses Face ID to unlock, so people's care records stay private if your phone is left open."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#173e35",
          "image": "./assets/mohuddle-icon-v2.png",
          "imageWidth": 224,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mohuddle checks you are at the home when you clock in and out. Your location is only read at those moments."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Mohuddle uses the microphone when you choose Speak your note. The recording is turned into words and not kept."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Mohuddle uses the camera when you add a photo to an incident report, such as an injury or damage.",
          "photosPermission": "Mohuddle lets you add a photo from your library to an incident report."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#173e35"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "logaxp",
    "extra": {
      "eas": {
        "projectId": "8ca39aa4-c32e-4f42-9f78-9fe66967ed40"
      },
      "router": {}
    },
    "icon": "./assets/mohuddle-icon-v2.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/8ca39aa4-c32e-4f42-9f78-9fe66967ed40",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
